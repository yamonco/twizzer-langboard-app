{
  "manifest_version": 3,
  "name": "Twizzer",
  "version": "0.1.0",
  "description": "Select a page element and create a Langboard app card with screenshots.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "identity"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Twizzer"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "key": "",
  "minimum_chrome_version": "116"
}
