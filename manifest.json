{
  "package_version": 1,
  "declaration": {
    "schema_version": 2,
    "key": "twizzer",
    "version": "0.1.0",
    "name": "Twizzer",
    "description": "Select a page element and create a Twizzer issue card in Langboard.",
    "capabilities": [
      "panels.render",
      "cards.create",
      "cards.read",
      "resources.read"
    ],
    "resource_types": [
      "site"
    ],
    "workflow_requirements": {
      "required": [
        "backlog"
      ],
      "optional": []
    },
    "card_lifecycle": {
      "element_feedback": {
        "archive": {
          "mode": "retain",
          "description": "Retain submitted feedback and evidence."
        },
        "restore": "retain_external_state"
      }
    },
    "panel": {
      "url": "https://twizzer.app/panel",
      "name": "Twizzer",
      "icon": "cursor"
    }
  },
  "panel_entry": "panel/index.html",
  "store": {
    "icon": "panel/assets/twizzer-cursor.svg",
    "icon_dark": "panel/assets/twizzer-cursor.svg"
  }
}
